{
  "siteUrl": "https://basagros.kz",
  "roots": [
    "site"
  ],
  "htmlFileNames": [
    "index.html"
  ],
  "excludeDirs": [
    "node_modules",
    ".git",
    "dist",
    "coverage",
    "vendor",
    "reports",
    "_tmp",
    "__pycache__"
  ],
  "excludeFilePatterns": [
    "index-clean.html",
    "index.legacy.html",
    "index__q_"
  ],
  "assetRoots": [
    "site/assets"
  ],
  "limits": {
    "imageBytes": 250000,
    "heroImageBytes": 160000,
    "maxHighPriorityImages": 1
  },
  "lighthouse": {
    "runs": 3,
    "performance": 0.9,
    "targetPerformance": 0.95,
    "accessibility": 0.95,
    "seo": 1.0,
    "lcpMs": 2500,
    "cls": 0.05,
    "tbtMs": 100
  }
}
